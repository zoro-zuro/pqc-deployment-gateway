# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
env/

# CRITICAL SECURITY RULE: Never commit private cryptographic keys
keys/*.key
keys/*.pem
keys/*.priv
keys/*.sec
!keys/.gitkeep

# Local OS files
.DS_Store
Thumbs.db

# Binaries
*.exe
*.zip

